<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>ZeroPinyin</Title>
        <Authors>神麤詭末</Authors>
        <Description>一个高性能、零内存分配的即时中文拼音匹配引擎</Description>
        <Version>1.0.6</Version>
        <PackageProjectUrl>https://github.com/scgm0/ZeroPinyin</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scgm0/ZeroPinyin.git</RepositoryUrl>
        <PackageTags>Pinyin;Chinese;Search;NFA;ZeroPinyin;Matcher</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <!-- .NET 11 启用运行时异步（Runtime Async V2）：async 方法由运行时管理挂起点，不再由编译器生成状态机 -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="../Resource/pinyin.txt" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
